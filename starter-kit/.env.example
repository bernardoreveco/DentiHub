# Solo NOMBRES de variables. Los valores van en un archivo .env propio, que NUNCA se sube a Git.
# (.gitignore ya excluye .env y .env.*, salvo este .env.example).

# --- Navegador (con Vite se exponen solo las que empiezan con VITE_; con Next.js serían NEXT_PUBLIC_*) ---
# Dirección del proyecto de Supabase.
VITE_SUPABASE_URL=
# Clave pública (publishable/anon). Es segura en el navegador SOLO si todas las tablas tienen RLS.
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Servidor (funciones de servidor, tareas de administración) ---
# Nunca con prefijo VITE_ / NEXT_PUBLIC_, y nunca en código que se envía al navegador.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Clave de servicio: se salta RLS. Solo en el servidor y solo para tareas de administración.
SUPABASE_SERVICE_ROLE_KEY=
